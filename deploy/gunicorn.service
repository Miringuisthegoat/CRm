[Unit]
Description=Carace Gunicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/carace
EnvironmentFile=/opt/carace/.env
ExecStart=/opt/carace/.venv/bin/gunicorn -k eventlet -w 1 -b 127.0.0.1:5000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
